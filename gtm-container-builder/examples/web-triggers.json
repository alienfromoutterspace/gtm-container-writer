[
  {
    "accountId": "0000000000",
    "containerId": "1111111",
    "triggerId": "358",
    "name": "CE - GA4 ecommerce (regex)",
    "type": "CUSTOM_EVENT",
    "customEventFilter": [
      {
        "type": "MATCH_REGEX",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "arg0",
            "value": "{{_event}}"
          },
          {
            "type": "TEMPLATE",
            "key": "arg1",
            "value": "^(view_item|view_cart|add_to_cart|remove_from_cart|begin_checkout|add_shipping_info|add_payment_info)$"
          }
        ]
      }
    ],
    "filter": [
      {
        "type": "EQUALS",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "arg0",
            "value": "{{DLV - dl_source}}"
          },
          {
            "type": "TEMPLATE",
            "key": "arg1",
            "value": "your_bridge_source"
          }
        ]
      }
    ]
  },
